tern=8 4;fontColor=#B35F00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="847" as="sourcePoint"/><mxPoint x="130" y="847" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lgt1" value="AMQP via RabbitMQ (asynchroon): na de bevestiging" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="140" y="835" width="340" height="24" as="geometry"/></mxCell><mxCell id="lgl2" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#808080;strokeWidth=1.5;dashed=1;dashPattern=2 4;fontColor=#606060;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="879" as="sourcePoint"/><mxPoint x="130" y="879" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lgt2" value="Infrastructuur: Eureka, configuratie" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="140" y="867" width="340" height="24" as="geometry"/></mxCell><mxCell id="lgl3" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="911" as="sourcePoint"/><mxPoint x="130" y="911" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lgt3" value="REST/HTTP via de gateway" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="140" y="899" width="340" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d2" name="US1 – Weekmenu"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="hd" value="&lt;b&gt;US1 – Het weekmenu bekijken&lt;/b&gt;&lt;br&gt;&lt;i&gt;Als klant zie ik de recepten van deze week, met bereidingstijd, aantal personen en allergenen, zodat ik kan kiezen.&lt;/i&gt;&lt;br&gt;&lt;b&gt;Communicatie:&lt;/b&gt; volledig synchroon (leesaanvraag, de frontend heeft het resultaat meteen nodig)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F0FA;strokeColor=#6C8EBF;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1440" height="80" as="geometry"/></mxCell><mxCell id="k" value="&lt;b&gt;Klant&lt;/b&gt;&lt;br&gt;[KLANT]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#052E56;fontSize=12;arcSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="130" height="70" as="geometry"/></mxCell><mxCell id="fe" value="&lt;b&gt;Angular-frontend&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="310" y="170" width="130" height="70" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;gateway&lt;/b&gt;&lt;br&gt;:8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B5394;fontColor=#ffffff;strokeColor=#073763;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="600" y="170" width="130" height="70" as="geometry"/></mxCell><mxCell id="rs" value="&lt;b&gt;recipe-service&lt;/b&gt;&lt;br&gt;Recipe · Ingredient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="890" y="170" width="170" height="70" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;recipe-db&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1230" y="170" width="110" height="70" as="geometry"/></mxCell><mxCell id="a" value="1 kiest week" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontColor=#333333;" edge="1" parent="1" source="k" target="fe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b" value="2 GET /api/recipes&lt;br&gt;?week=2026-W47" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontColor=#333333;" edge="1" parent="1" source="fe" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c" value="3 route /api/recipes" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontColor=#333333;" edge="1" parent="1" source="gw" target="rs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d" value="4 query" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#6C8EBF;strokeWidth=1.5;startArrow=block;startFill=1;" edge="1" parent="1" source="rs" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n" value="&lt;b&gt;5 Antwoord: 200&lt;/b&gt; met een lijst DTO&#x27;s: naam, bereidingstijd, standaard aantal personen en allergenen.&lt;br&gt;Andere services hoeven niet aangesproken te worden. Er worden nooit entities teruggegeven, enkel DTO&#x27;s.&lt;br&gt;&lt;b&gt;Ook beschikbaar:&lt;/b&gt; GET /api/recipes/{id} (200 / 404) voor receptdetails inclusief ingrediënten." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="300" width="1000" height="90" as="geometry"/></mxCell><mxCell id="lg" value="&lt;b&gt;Legende:&lt;/b&gt; blauw doorgetrokken = Feign/REST (synchroon) · oranje gestippeld = AMQP via RabbitMQ (asynchroon) · grijs gestippeld = infrastructuur" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="1440" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d3" name="US2 – Bestellen"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="hd" value="&lt;b&gt;US2 – Een box samenstellen en bestellen&lt;/b&gt;&lt;br&gt;&lt;i&gt;Als klant kies ik recepten, personen en een leverslot en plaats ik mijn bestelling. Onvoldoende voorraad of een vol slot hoor ik meteen.&lt;/i&gt;&lt;br&gt;&lt;b&gt;Communicatie:&lt;/b&gt; controles &lt;b&gt;synchroon&lt;/b&gt; (Feign), alles ná de bevestiging &lt;b&gt;asynchroon&lt;/b&gt; (RabbitMQ)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F0FA;strokeColor=#6C8EBF;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1440" height="80" as="geometry"/></mxCell><mxCell id="l1" value="Fase 1 – synchroon: controleren en bevestigen (de klant wacht op het antwoord)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#9E9E9E;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=3;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="1440" height="330" as="geometry"/></mxCell><mxCell id="k" value="&lt;b&gt;Klant&lt;/b&gt;&lt;br&gt;[KLANT]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#052E56;fontSize=12;arcSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="110" height="60" as="geometry"/></mxCell><mxCell id="fe" value="&lt;b&gt;Angular&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="280" y="250" width="120" height="60" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;gateway&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B5394;fontColor=#ffffff;strokeColor=#073763;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="530" y="250" width="120" height="60" as="geometry"/></mxCell><mxCell id="os" value="&lt;b&gt;order-service&lt;/b&gt;&lt;br&gt;berekent hoeveelheid =&lt;br&gt;hoeveelheid × personen / basisaantal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="780" y="210" width="230" height="140" as="geometry"/></mxCell><mxCell id="odb" value="&lt;b&gt;order-db&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="375" width="110" height="60" as="geometry"/></mxCell><mxCell id="rs" value="&lt;b&gt;recipe-service&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1230" y="160" width="200" height="70" as="geometry"/></mxCell><mxCell id="is" value="&lt;b&gt;inventory-service&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1230" y="260" width="200" height="70" as="geometry"/></mxCell><mxCell id="ds" value="&lt;b&gt;delivery-service&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1230" y="360" width="200" height="70" as="geometry"/></mxCell><mxCell id="a" value="1 kiest recepten,&lt;br&gt;personen en slot" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontColor=#333333;" edge="1" parent="1" source="k" target="fe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b" value="2 POST /api/orders" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontColor=#333333;" edge="1" parent="1" source="fe" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c" value="route&lt;br&gt;+ X-User-Id" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontColor=#333333;" edge="1" parent="1" source="gw" target="os"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d" value="6 opslaan als CONFIRMED" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#6C8EBF;strokeWidth=1.5;startArrow=block;startFill=1;" edge="1" parent="1" source="os" target="odb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f1" value="3 Feign GET /internal/recipes/{id}&lt;br&gt;onbekend recept → 404" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#1F5FA8;strokeWidth=2;fontColor=#1F5FA8;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="os" target="rs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f2" value="4 Feign POST /internal/stock/check&lt;br&gt;te weinig → 409 INSUFFICIENT_STOCK" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#1F5FA8;strokeWidth=2;fontColor=#1F5FA8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="os" target="is"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f3" value="5 Feign GET /internal/delivery-slots/{id}&lt;br&gt;onbekend/vol → 409 SLOT_FULL" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#1F5FA8;strokeWidth=2;fontColor=#1F5FA8;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="os" target="ds"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l2" value="Fase 2 – asynchroon: ná de bevestiging (de bestelling slaagt ook als een consumer plat ligt)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#9E9E9E;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=3;" vertex="1" parent="1"><mxGeometry x="20" y="480" width="1440" height="370" as="geometry"/></mxCell><mxCell id="os2" value="&lt;b&gt;order-service&lt;/b&gt;&lt;br&gt;API antwoordt &lt;b&gt;201&lt;/b&gt; met de bestelling,&lt;br&gt;daarna publish" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="600" width="220" height="90" as="geometry"/></mxCell><mxCell id="rmq" value="RabbitMQ" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF4E5;strokeColor=#E07B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#9A5200;fontSize=11;fontStyle=1;arcSize=5;" vertex="1" parent="1"><mxGeometry x="340" y="540" width="300" height="170" as="geometry"/></mxCell><mxCell id="exo" value="&lt;b&gt;order.events&lt;/b&gt;&lt;br&gt;routing key order.confirmed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD8A8;strokeColor=#E07B00;fontColor=#4A2800;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="600" width="240" height="70" as="geometry"/></mxCell><mxCell id="i2" value="&lt;b&gt;inventory-service&lt;/b&gt;&lt;br&gt;maakt StockReservation aan en&lt;br&gt;verlaagt de beschikbare voorraad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="880" y="520" width="260" height="80" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;delivery-service&lt;/b&gt;&lt;br&gt;voegt DeliveryStop toe aan het slot&lt;br&gt;en verhoogt de bezetting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="880" y="630" width="260" height="80" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;notification-service&lt;/b&gt;&lt;br&gt;registreert (logt) dat de bestelling&lt;br&gt;bevestigd is" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="880" y="740" width="260" height="80" as="geometry"/></mxCell><mxCell id="p" value="7 publish order.confirmed&lt;br&gt;(bevat alle nodige gegevens)" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#E07B00;strokeWidth=2;dashed=1;dashPattern=8 4;fontColor=#B35F00;" edge="1" parent="1" source="os2" target="exo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1" value="8a" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#E07B00;strokeWidth=2;dashed=1;dashPattern=8 4;fontColor=#B35F00;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="exo" target="i2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value="8b" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#E07B00;strokeWidth=2;dashed=1;dashPattern=8 4;fontColor=#B35F00;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="exo" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c3" value="8c" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#E07B00;strokeWidth=2;dashed=1;dashPattern=8 4;fontColor=#B35F00;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="exo" target="n2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nt" value="Valt een consumer tijdelijk uit? Het bericht blijft in zijn &lt;b&gt;durable queue&lt;/b&gt; en wordt verwerkt zodra de service terug is. De bestelling blijft geslaagd.&lt;br&gt;&lt;br&gt;Elk event krijgt een &lt;b&gt;traceId&lt;/b&gt; mee in de headers." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1190" y="560" width="260" height="170" as="geometry"/></mxCell><mxCell id="lg" value="&lt;b&gt;Legende:&lt;/b&gt; blauw doorgetrokken = Feign/REST (synchroon) · oranje gestippeld = AMQP via RabbitMQ (asynchroon) · grijs gestippeld = infrastructuur" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="860" width="1440" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d4" name="US3 – Mijn bestellingen"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="hd" value="&lt;b&gt;US3 – Mijn bestellingen volgen&lt;/b&gt;&lt;br&gt;&lt;i&gt;Als klant zie ik mijn bestellingen met hun status: PLACED, CONFIRMED, IN_DELIVERY, DELIVERED of CANCELLED.&lt;/i&gt;&lt;br&gt;&lt;b&gt;Communicatie:&lt;/b&gt; lezen &lt;b&gt;synchroon&lt;/b&gt; uit de eigen database; status bijwerken via &lt;b&gt;asynchrone&lt;/b&gt; events" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F0FA;strokeColor=#6C8EBF;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1440" height="80" as="geometry"/></mxCell><mxCell id="k" value="&lt;b&gt;Klant&lt;/b&gt;&lt;br&gt;[KLANT]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#052E56;fontSize=12;arcSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="160" width="130" height="70" as="geometry"/></mxCell><mxCell id="fe" value="&lt;b&gt;Angular-frontend&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="290" y="160" width="130" height="70" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;gateway&lt;/b&gt;&lt;br&gt;:8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B5394;fontColor=#ffffff;strokeColor=#073763;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="560" y="160" width="130" height="70" as="geometry"/></mxCell><mxCell id="os" value="&lt;b&gt;order-service&lt;/b&gt;&lt;br&gt;Order · OrderLine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="830" y="160" width="200" height="70" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;order-db&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1230" y="160" width="110" height="70" as="geometry"/></mxCell><mxCell id="a" value="1 opent &#x27;Mijn bestellingen&#x27;" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontColor=#333333;" edge="1" parent="1" source="k" target="fe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b" value="2 GET /api/orders&lt;br&gt;of /api/orders/{id}" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontColor=#333333;" edge="1" parent="1" source="fe" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c" value="3 route&lt;br&gt;(filter op X-User-Id)" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontColor=#333333;" edge="1" parent="1" source="gw" target="os"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d" value="4 lezen" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#6C8EBF;strokeWidth=1.5;startArrow=block;startFill=1;" edge="1" parent="1" source="os" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l2" value="Hoe blijft de status actueel? Order-service consumeert zelf de events, geen extra aanvraag bij delivery-service nodig" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#9E9E9E;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;arcSize=3;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="1440" height="230" as="geometry"/></mxCell><mxCell id="ds" value="&lt;b&gt;delivery-service&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="200" height="70" as="geometry"/></mxCell><mxCell id="rmq" value="RabbitMQ" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF4E5;strokeColor=#E07B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#9A5200;fontSize=11;fontStyle=1;arcSize=5;" vertex="1" parent="1"><mxGeometry x="400" y="340" width="300" height="150" as="geometry"/></mxCell><mxCell id="exd" value="&lt;b&gt;delivery.events&lt;/b&gt;&lt;br&gt;delivery.started · order.delivered" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD8A8;strokeColor=#E07B00;fontColor=#4A2800;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="400" width="240" height="70" as="geometry"/></mxCell><mxCell id="p" value="publiceert" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#E07B00;strokeWidth=2;dashed=1;dashPattern=8 4;fontColor=#B35F00;" edge="1" parent="1" source="ds" target="exd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="q" value="consumeert:&lt;br&gt;delivery.started → IN_DELIVERY&lt;br&gt;order.delivered → DELIVERED" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#E07B00;strokeWidth=2;dashed=1;dashPattern=8 4;fontColor=#B35F00;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="exd" target="os"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="st" value="&lt;b&gt;Levenscyclus&lt;/b&gt;&lt;br&gt;PLACED → CONFIRMED → IN_DELIVERY → DELIVERED&lt;br&gt;annuleren kan bij PLACED/CONFIRMED → CANCELLED&lt;br&gt;&lt;br&gt;PLACED bestaat enkel binnen de transactie van POST /api/orders." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="340" width="440" height="150" as="geometry"/></mxCell><mxCell id="lg" value="&lt;b&gt;Legende:&lt;/b&gt; blauw doorgetrokken = Feign/REST (synchroon) · oranje gestippeld = AMQP via RabbitMQ (asynchroon) · grijs gestippeld = infrastructuur" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="540" width="1440" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d5" name="US4 – Voorraad"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="hd" value="&lt;b&gt;US4 – Voorraad beheren&lt;/b&gt;&lt;br&gt;&lt;i&gt;Als medewerker zie ik welke ingrediënten opraken en kan ik de voorraad aanvullen.&lt;/i&gt;&lt;br&gt;&lt;b&gt;Communicatie:&lt;/b&gt; volledig &lt;b&gt;synchroon&lt;/b&gt; binnen inventory-service" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F0FA;strokeColor=#6C8EBF;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1440" height="80" as="geometry"/></mxCell><mxCell id="k" value="&lt;b&gt;Medewerker&lt;/b&gt;&lt;br&gt;[MEDEWERKER]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#052E56;fontSize=12;arcSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="140" height="70" as="geometry"/></mxCell><mxCell id="fe" value="&lt;b&gt;Angular-frontend&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="170" width="130" height="70" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;gateway&lt;/b&gt;&lt;br&gt;:8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B5394;fontColor=#ffffff;strokeColor=#073763;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="570" y="170" width="130" height="70" as="geometry"/></mxCell><mxCell id="is" value="&lt;b&gt;inventory-service&lt;/b&gt;&lt;br&gt;StockItem · StockReservation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="840" y="170" width="210" height="70" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;inventory-db&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1250" y="170" width="120" height="70" as="geometry"/></mxCell><mxCell id="a" value="1 opent voorraadscherm" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontColor=#333333;" edge="1" parent="1" source="k" target="fe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b" value="2 GET /api/stock&lt;br&gt;?lowOnly=true" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontColor=#333333;" edge="1" parent="1" source="fe" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c" value="3 route + X-User-Role" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontColor=#333333;" edge="1" parent="1" source="gw" target="is"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d" value="4 lezen / bijwerken" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#6C8EBF;strokeWidth=1.5;startArrow=block;startFill=1;" edge="1" parent="1" source="is" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n1" value="&lt;b&gt;Opraken zien&lt;/b&gt;&lt;br&gt;GET /api/stock → alle voorraad (200)&lt;br&gt;GET /api/stock?lowOnly=true → enkel items onder de drempelwaarde" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="450" height="100" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Aanvullen&lt;/b&gt;&lt;br&gt;PATCH /api/stock/{ingredientId}/replenish&lt;br&gt;body: { &quot;quantity&quot;: 50 } → 200 · onbekend ingrediënt 404 · ongeldige body 400" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="300" width="480" height="100" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Autorisatie&lt;/b&gt;&lt;br&gt;Enkel rol MEDEWERKER, anders 403 FORBIDDEN (rol uit header X-User-Role)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="300" width="450" height="100" as="geometry"/></mxCell><mxCell id="lg" value="&lt;b&gt;Legende:&lt;/b&gt; blauw doorgetrokken = Feign/REST (synchroon) · oranje gestippeld = AMQP via RabbitMQ (asynchroon) · grijs gestippeld = infrastructuur" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="1440" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d6" name="US5 – Leverronde"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="hd" value="&lt;b&gt;US5 – Een leverronde afwerken&lt;/b&gt;&lt;br&gt;&lt;i&gt;Als chauffeur zie ik welke bestellingen in mijn rit zitten en markeer ik ze als geleverd, zodat de klant weet dat zijn box er is.&lt;/i&gt;&lt;br&gt;&lt;b&gt;Communicatie:&lt;/b&gt; de actie van de chauffeur is &lt;b&gt;synchroon&lt;/b&gt; klaar na opslaan; de gevolgen lopen &lt;b&gt;asynchroon&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F0FA;strokeColor=#6C8EBF;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1440" height="80" as="geometry"/></mxCell><mxCell id="k" value="&lt;b&gt;Chauffeur&lt;/b&gt;&lt;br&gt;[CHAUFFEUR]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#052E56;fontSize=12;arcSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="140" height="70" as="geometry"/></mxCell><mxCell id="fe" value="&lt;b&gt;Angular-frontend&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="290" y="150" width="130" height="70" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;gateway&lt;/b&gt;&lt;br&gt;:8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B5394;fontColor=#ffffff;strokeColor=#073763;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="550" y="150" width="130" height="70" as="geometry"/></mxCell><mxCell id="ds" value="&lt;b&gt;delivery-service&lt;/b&gt;&lt;br&gt;DeliveryRun · DeliveryStop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="810" y="150" width="220" height="70" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;delivery-db&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1230" y="150" width="120" height="70" as="geometry"/></mxCell><mxCell id="a" value="1 GET /api/delivery-runs&lt;br&gt;?date=..." style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontColor=#333333;" edge="1" parent="1" source="k" target="fe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b" value="2 PATCH …/{id}/start&lt;br&gt;3 PATCH …/orders/{orderId}/delivered" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontColor=#333333;" edge="1" parent="1" source="fe" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c" value="route" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontColor=#333333;" edge="1" parent="1" source="gw" target="ds"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d" value="rit en stops&lt;br&gt;opslaan" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#6C8EBF;strokeWidth=1.5;startArrow=block;startFill=1;" edge="1" parent="1" source="ds" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rmq" value="RabbitMQ" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF4E5;strokeColor=#E07B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#9A5200;fontSize=11;fontStyle=1;arcSize=5;" vertex="1" parent="1"><mxGeometry x="640" y="330" width="450" height="150" as="geometry"/></mxCell><mxCell id="exd" value="&lt;b&gt;delivery.events&lt;/b&gt;&lt;br&gt;delivery.started · order.delivered" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD8A8;strokeColor=#E07B00;fontColor=#4A2800;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="390" width="310" height="70" as="geometry"/></mxCell><mxCell id="p" value="4 publiceert na opslaan:&lt;br&gt;delivery.started (start)&lt;br&gt;order.delivered (per stop)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#E07B00;strokeWidth=2;dashed=1;dashPattern=8 4;fontColor=#B35F00;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ds" target="exd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="os" value="&lt;b&gt;order-service&lt;/b&gt;&lt;br&gt;start → IN_DELIVERY&lt;br&gt;delivered → DELIVERED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="560" y="600" width="240" height="90" as="geometry"/></mxCell><mxCell id="odb" value="&lt;b&gt;order-db&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="620" y="740" width="110" height="60" as="geometry"/></mxCell><mxCell id="ns" value="&lt;b&gt;notification-service&lt;/b&gt;&lt;br&gt;verwittigt de klant (log)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="980" y="600" width="240" height="90" as="geometry"/></mxCell><mxCell id="o1" value="5 consumeert" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#E07B00;strokeWidth=2;dashed=1;dashPattern=8 4;fontColor=#B35F00;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="exd" target="os"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o2" value="6 consumeert" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#E07B00;strokeWidth=2;dashed=1;dashPattern=8 4;fontColor=#B35F00;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="exd" target="ns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o3" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#6C8EBF;strokeWidth=1.5;startArrow=block;startFill=1;" edge="1" parent="1" source="os" target="odb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n" value="&lt;b&gt;Eindverantwoordelijkheid&lt;/b&gt;&lt;br&gt;De chauffeur hoeft niet te wachten tot alle consumers klaar zijn.&lt;br&gt;De actie is geslaagd zodra delivery-service de wijziging heeft opgeslagen.&lt;br&gt;&lt;br&gt;Alleen rol CHAUFFEUR. Onbekende rit of bestelling → 404.&lt;br&gt;Ook beschikbaar: GET /api/delivery-runs/{id}." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="520" height="170" as="geometry"/></mxCell><mxCell id="lg" value="&lt;b&gt;Legende:&lt;/b&gt; blauw doorgetrokken = Feign/REST (synchroon) · oranje gestippeld = AMQP via RabbitMQ (asynchroon) · grijs gestippeld = infrastructuur" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="830" width="1440" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d7" name="US6 – Annuleren"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="hd" value="&lt;b&gt;US6 – Een bestelling annuleren&lt;/b&gt;&lt;br&gt;&lt;i&gt;Als klant annuleer ik een bestelling zolang ze nog niet onderweg is, zodat mijn gereserveerde ingrediënten weer vrijkomen.&lt;/i&gt;&lt;br&gt;&lt;b&gt;Communicatie:&lt;/b&gt; annuleren zelf &lt;b&gt;synchroon&lt;/b&gt; (200); opruimwerk bij andere services &lt;b&gt;asynchroon&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F0FA;strokeColor=#6C8EBF;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1440" height="80" as="geometry"/></mxCell><mxCell id="k" value="&lt;b&gt;Klant&lt;/b&gt;&lt;br&gt;[KLANT]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#052E56;fontSize=12;arcSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="130" height="70" as="geometry"/></mxCell><mxCell id="fe" value="&lt;b&gt;Angular-frontend&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="290" y="150" width="130" height="70" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;gateway&lt;/b&gt;&lt;br&gt;:8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B5394;fontColor=#ffffff;strokeColor=#073763;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="550" y="150" width="130" height="70" as="geometry"/></mxCell><mxCell id="os" value="&lt;b&gt;order-service&lt;/b&gt;&lt;br&gt;Order · OrderLine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="810" y="150" width="220" height="70" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;order-db&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1230" y="150" width="110" height="70" as="geometry"/></mxCell><mxCell id="a" value="1 klikt &#x27;annuleren&#x27;" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontColor=#333333;" edge="1" parent="1" source="k" target="fe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b" value="2 PATCH /api/orders/{id}/cancel" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontColor=#333333;" edge="1" parent="1" source="fe" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c" value="route" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontColor=#333333;" edge="1" parent="1" source="gw" target="os"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d" value="3 status = CANCELLED" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#6C8EBF;strokeWidth=1.5;startArrow=block;startFill=1;" edge="1" parent="1" source="os" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n" value="&lt;b&gt;Controle in order-service&lt;/b&gt;&lt;br&gt;• enkel eigen bestelling (X-User-Id)&lt;br&gt;• enkel status PLACED of CONFIRMED&lt;br&gt;• IN_DELIVERY / DELIVERED → 409 ORDER_NOT_CANCELLABLE&lt;br&gt;• onbekende bestelling → 404&lt;br&gt;&lt;br&gt;&lt;b&gt;Antwoord 200&lt;/b&gt; staat los van de consumers." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="420" height="190" as="geometry"/></mxCell><mxCell id="rmq" value="RabbitMQ" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF4E5;strokeColor=#E07B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#9A5200;fontSize=11;fontStyle=1;arcSize=5;" vertex="1" parent="1"><mxGeometry x="640" y="310" width="450" height="150" as="geometry"/></mxCell><mxCell id="exo" value="&lt;b&gt;order.events&lt;/b&gt;&lt;br&gt;routing key order.cancelled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD8A8;strokeColor=#E07B00;fontColor=#4A2800;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="370" width="310" height="70" as="geometry"/></mxCell><mxCell id="p" value="4 publiceert order.cancelled" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#E07B00;strokeWidth=2;dashed=1;dashPattern=8 4;fontColor=#B35F00;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="os" target="exo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="is" value="&lt;b&gt;inventory-service&lt;/b&gt;&lt;br&gt;geeft de StockReservation&lt;br&gt;opnieuw vrij" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="380" y="580" width="260" height="90" as="geometry"/></mxCell><mxCell id="ds" value="&lt;b&gt;delivery-service&lt;/b&gt;&lt;br&gt;verwijdert de DeliveryStop en&lt;br&gt;geeft de plaats in het slot terug" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="740" y="580" width="260" height="90" as="geometry"/></mxCell><mxCell id="ns" value="&lt;b&gt;notification-service&lt;/b&gt;&lt;br&gt;meldt de annulering&lt;br&gt;aan de klant (log)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1100" y="580" width="260" height="90" as="geometry"/></mxCell><mxCell id="c1" value="5a" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#E07B00;strokeWidth=2;dashed=1;dashPattern=8 4;fontColor=#B35F00;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="exo" target="is"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2" value="5b" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#E07B00;strokeWidth=2;dashed=1;dashPattern=8 4;fontColor=#B35F00;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="exo" target="ds"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c3" value="5c" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#E07B00;strokeWidth=2;dashed=1;dashPattern=8 4;fontColor=#B35F00;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="exo" target="ns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lg" value="&lt;b&gt;Legende:&lt;/b&gt; blauw doorgetrokken = Feign/REST (synchroon) · oranje gestippeld = AMQP via RabbitMQ (asynchroon) · grijs gestippeld = infrastructuur" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="800" width="1440" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>