<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0"><diagram id="d1" name="Container diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;font style=&#x27;font-size:18px&#x27;&gt;&lt;b&gt;Maaltijdboxen aan huis – Container diagram&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Backend voor een platform dat wekelijks maaltijdboxen samenstelt en bezorgt.&lt;br&gt;Spring Boot 4.0.8 · Spring Cloud 2025.1.3 · Java 21 · Angular-frontend" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="480" height="80" as="geometry"/></mxCell><mxCell id="princ" value="&lt;b&gt;Uitgangspunten&lt;/b&gt;&lt;br&gt;1. Frontend praat enkel met de gateway; alleen &lt;b&gt;/api/**&lt;/b&gt; wordt doorgestuurd, rest geeft 404.&lt;br&gt;2. Elke service heeft een eigen database; verwijzingen enkel via ID&#x27;s of snapshots.&lt;br&gt;3. Antwoord nodig om verder te kunnen → &lt;b&gt;Feign (sync)&lt;/b&gt;. Kan na de bevestiging → &lt;b&gt;RabbitMQ (async)&lt;/b&gt;.&lt;br&gt;4. &lt;b&gt;/internal/**&lt;/b&gt; is enkel voor service-naar-service en wordt niet door de gateway doorgestuurd." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="480" height="170" as="geometry"/></mxCell><mxCell id="p0" value="&lt;b&gt;Klant&lt;/b&gt;&lt;br&gt;[Persoon · rol KLANT]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#052E56;fontSize=12;arcSize=18;" vertex="1" parent="1"><mxGeometry x="440" y="20" width="180" height="70" as="geometry"/></mxCell><mxCell id="pe0" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontColor=#333333;" edge="1" parent="1" source="p0" target="fe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1" value="&lt;b&gt;Medewerker&lt;/b&gt;&lt;br&gt;[Persoon · rol MEDEWERKER]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#052E56;fontSize=12;arcSize=18;" vertex="1" parent="1"><mxGeometry x="700" y="20" width="180" height="70" as="geometry"/></mxCell><mxCell id="pe1" value="HTTPS" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontColor=#333333;" edge="1" parent="1" source="p1" target="fe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2" value="&lt;b&gt;Chauffeur&lt;/b&gt;&lt;br&gt;[Persoon · rol CHAUFFEUR]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#052E56;fontSize=12;arcSize=18;" vertex="1" parent="1"><mxGeometry x="960" y="20" width="180" height="70" as="geometry"/></mxCell><mxCell id="pe2" value="" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontColor=#333333;" edge="1" parent="1" source="p2" target="fe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fe" value="&lt;b&gt;Angular-frontend&lt;/b&gt;&lt;br&gt;[Angular] AuthService houdt rol en gebruiker bij (loginscherm zonder backend)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="540" y="140" width="500" height="70" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;gateway&lt;/b&gt; [Spring Cloud Gateway · :8080]&lt;br&gt;Enkel /api/** · onbekend pad = 404 · CORS&lt;br&gt;Stuurt X-User-Id en X-User-Role door" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B5394;fontColor=#ffffff;strokeColor=#073763;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="540" y="290" width="500" height="70" as="geometry"/></mxCell><mxCell id="e_fe_gw" value="REST/JSON via /api/**&lt;br&gt;headers X-User-Id, X-User-Role" style="html=1;rounded=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontColor=#333333;" edge="1" parent="1" source="fe" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="disc" value="&lt;b&gt;discovery-service&lt;/b&gt;&lt;br&gt;[Eureka]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8C8C;fontColor=#ffffff;strokeColor=#5E5E5E;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="290" width="200" height="70" as="geometry"/></mxCell><mxCell id="cfg" value="&lt;b&gt;config-service&lt;/b&gt;&lt;br&gt;[Spring Cloud Config]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8C8C;fontColor=#ffffff;strokeColor=#5E5E5E;fontSize=11;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1460" y="290" width="200" height="70" as="geometry"/></mxCell><mxCell id="grp" value="Microservices – elk met eigen database en Eureka-/Config-client" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#2E6295;verticalAlign=bottom;align=left;spacingLeft=10;spacingBottom=4;fontStyle=1;fontSize=11;fontColor=#2E6295;arcSize=2;" vertex="1" parent="1"><mxGeometry x="0" y="410" width="1680" height="330" as="geometry"/></mxCell><mxCell id="recipe" value="&lt;b&gt;recipe-service&lt;/b&gt;&lt;br&gt;[Spring Boot]&lt;br&gt;Weekaanbod: recepten, ingrediënten, allergenen&lt;br&gt;Recipe · Ingredient · RecipeIngredient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="200" height="110" as="geometry"/></mxCell><mxCell id="order" value="&lt;b&gt;order-service&lt;/b&gt;&lt;br&gt;[Spring Boot]&lt;br&gt;Het hart: bestelling en statusverloop&lt;